{
  "compilerOptions": {
    "target": "es2022", "module": "esnext", "moduleResolution": "bundler", "lib": ["ES2023", "DOM"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true, "isolatedModules": true,
    "noUnusedLocals": true, "noFallthroughCasesInSwitch": true, "types": []
  },
  "include": ["src"]
}
